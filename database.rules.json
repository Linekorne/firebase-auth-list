{"rules":{"items":{".read":"auth != null",".indexOn":["createdAt"],"$itemId":{".write":"auth != null && !data.exists() && newData.exists()",".validate":"newData.hasChildren(['text', 'uid', 'authorName', 'createdAt'])","text":{".validate":"newData.isString() && newData.val().length > 0 && newData.val().length <= 500"},"uid":{".validate":"newData.val() === auth.uid"},"authorName":{".validate":"newData.isString() && newData.val().length <= 100"},"createdAt":{".validate":"newData.val() === now"},"$other":{".validate":false}}}}}
